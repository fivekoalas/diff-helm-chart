{
  "name": "@fivekoalas/diff-helm-chart",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A Github action to diff helm chart based on git commit",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint src",
    "package": "ncc build --source-map --license licenses.txt",
    "test": "vitest run",
    "all": "pnpm build && pnpm format && pnpm lint && pnpm package && pnpm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fivekoalas/diff-helm-chart.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "helm",
    "chart",
    "diff"
  ],
  "author": "Rodrigo Sanabria <rodrigo@sanabria.dev>",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@vercel/ncc": "0.45.0",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-plugin-github": "6.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  }
}
